# ==============================================================================
# HCM LITE ENTERPRISE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT COMMIT SENSITIVE PRODUCTION KEYS TO SOURCE CONTROL
# ==============================================================================

# 1. Database Connection (PostgreSQL 14+)
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/HCM

# 2. Azure OpenAI Service (M8: Natural Language AI & Smart Leave)
AZURE_OPENAI_API_KEY="your_azure_openai_api_key_here"
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-5.4-mini"
AZURE_OPENAI_API_VERSION="2025-01-01-preview"

# 3. Azure Communication Services (M9: Automated Email Delivery & OTPs)
AZURE_COMMUNICATION_CONNECTION_STRING="endpoint=https://your-acs-resource.communication.azure.com/;accesskey=your_access_key_here"
AZURE_EMAIL_SENDER="noreply@yourdomain.com"

# 4. ImgBB Cloud Storage (Organization Branding & Logo Uploading)
IMGBB_API_KEY="your_imgbb_v1_api_key_here"

# 5. Application Security & JWT Tokens
SECRET_KEY="generate_a_secure_random_64_char_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 6. CORS Whitelist
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "https://your-frontend.vercel.app"]
